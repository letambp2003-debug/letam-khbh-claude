# === AUTH (Google OAuth qua NextAuth) ===
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<domain-cua-ban>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chạy: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL công khai của app (khi deploy Vercel: https://ten-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# === AI (Anthropic Claude API) ===
# Lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Tuỳ chọn, mặc định dùng claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# === DATABASE (Vercel Postgres) ===
# Vercel tự động điền các biến này khi bạn tạo Postgres storage và Connect tới project
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
