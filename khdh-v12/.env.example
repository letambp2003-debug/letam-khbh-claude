# ============================================================
# KHDH V12 RC2 - mau cau hinh moi truong day du
# Copy file nay thanh .env (thu muc goc) VA server/.env truoc khi chay.
# KHONG commit file .env / .env.local that len git.
# ============================================================

# ---- Server ----
PORT=8787
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- SQLite ----
# Duong dan file DB cuc bo (tu tao neu chua co).
SQLITE_PATH=./storage/khdh-v12.sqlite

# ---- Google OAuth (Google Identity Services) ----
# Lay tai: https://console.cloud.google.com/apis/credentials
# 1. Tao OAuth Client ID loai "Web application".
# 2. Authorized JavaScript origins: http://localhost:5173 (va domain that khi deploy).
# 3. KHONG can "Authorized redirect URIs" vi dung luong dang nhap phia client
#    (Google Identity Services / One Tap tra ID token truc tiep ve trinh duyet),
#    server chi xac thuc ID token bang GOOGLE_CLIENT_ID ben duoi.
# 4. Neu chi muon giao vien trong truong dang nhap duoc (Google Workspace for
#    Education), vao OAuth consent screen -> chon "Internal".
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Danh sach domain email duoc phep dang nhap, cach nhau bang dau phay.
# De trong = cho phep moi tai khoan Google dang nhap (khong khuyen nghi cho production).
# Vi du chi cho phep giao vien truong ABC: ALLOWED_EMAIL_DOMAINS=truongabc.edu.vn
ALLOWED_EMAIL_DOMAINS=

# ---- Ma hoa API key luu trong DB (AES-256-GCM) ----
# Sinh bang: openssl rand -hex 32   (BAT BUOC dung 32 byte = 64 ky tu hex)
API_KEY_ENCRYPTION_SECRET=

# ---- (Tuy chon) AI provider mac dinh phia server, dung khi giao vien CHUA ----
# ---- tu nhap API key rieng tren giao dien (moi giao vien co the ghi de).   ----
# Anthropic Claude - lay tai https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Google AI (Gemini) - lay tai https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# ---- Session ----
# Sinh bang: openssl rand -base64 32
SESSION_SECRET=
